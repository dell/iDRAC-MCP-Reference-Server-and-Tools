# =============================================================================
# Agentic Admin for Dell PowerEdge - Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# The orchestrator uses Dell GenAI API by default
# Configure your LLM provider credentials here

# Dell GenAI API (default provider)
DEV_GENAI_API_URL=https://genai-api-dev.dell.com/v1
DEV_GENAI_API_KEY=your-api-key-here

# Alternative: OpenAI (requires changing config/test_config.yaml)
# OPENAI_API_KEY=your-openai-key-here

# Alternative: Anthropic Claude (requires changing config/test_config.yaml)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# =============================================================================
# Credential Database Encryption
# =============================================================================
# Master password for encrypting iDRAC credentials in the database
# IMPORTANT: Use a strong, unique password in production!
#
# Generate a secure password with:
#   openssl rand -base64 32
#
# Default: "changeme-in-production" (NOT SECURE!)

CREDENTIAL_MASTER_PASSWORD=changeme-in-production

# =============================================================================
# Service Configuration (Advanced - usually not needed to change)
# =============================================================================

# MCP Server URL (used by orchestrator to connect to MCP server)
# Default: http://mcp-server:8000 (Docker Compose internal networking)
# MCP_SERVER_URL=http://mcp-server:8000

# Orchestrator URL (used by chat-ui to connect to orchestrator)
# Default: http://orchestrator:8001 (Docker Compose internal networking)
# ORCHESTRATOR_URL=http://orchestrator:8001

# Orchestrator request timeout (seconds)
# ORCHESTRATOR_TIMEOUT=180

# Credential database path (inside container)
# Default: /data/credentials.db (shared Docker volume)
# CREDENTIAL_DB_PATH=/data/credentials.db

# =============================================================================
# iDRAC Systems Configuration
# =============================================================================
# iDRAC systems are configured via the Chat UI web interface
# No environment variables needed here!
#
# Access the Chat UI at: http://localhost:8501
# Then use the sidebar to add your iDRAC systems with credentials
#
# Alternatively, you can import systems from a CSV/Excel file
# See the template download button in the Chat UI
# =============================================================================

# =============================================================================
# Development & Debugging (Optional)
# =============================================================================

# Enable verbose logging
# DEBUG=true

# Python logging level
# LOG_LEVEL=INFO

# Disable SSL verification (for testing only - NOT for production!)
# PYTHONHTTPSVERIFY=0
